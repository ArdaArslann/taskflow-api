{
  "info": {
    "name": "Task Management API",
    "description": "Full CRUD + filtering/search/sort/pagination + reporting coverage for the Task Management REST API, plus negative cases (400/404) for every endpoint. Run with Newman against a running instance of the server (see package.json \"postman:test\" script).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Tasks - Create",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response envelope and created task fields are correct', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.title).to.eql('Write Postman collection');",
                  "    pm.expect(json.data.status).to.eql('todo');",
                  "    pm.expect(json.data.priority).to.eql('high');",
                  "    pm.expect(json.data.assignee).to.eql('ArdaArslann');",
                  "    pm.collectionVariables.set('taskId', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write Postman collection\",\n  \"description\": \"Cover CRUD and reporting endpoints\",\n  \"priority\": \"high\",\n  \"assignee\": \"ArdaArslann\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "tasks" ]
            }
          }
        },
